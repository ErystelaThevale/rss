# DeepL API key. Get one at https://www.deepl.com/pro-api
# Free-tier keys end in ":fx" and automatically use the free API endpoint.
DEEPL_TOKEN=

# Target language for translated titles (DeepL target_lang code, e.g. JA, EN, DE, FR).
# Source language is auto-detected by DeepL and does not need to be set.
RSS_TARGET_LANG=JA
